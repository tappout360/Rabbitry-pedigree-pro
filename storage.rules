rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Breeder photo uploads: only the owning breeder can upload/read/delete
    match /breeders/{breederId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == breederId;
      allow write: if request.auth != null 
                   && request.auth.uid == breederId
                   && request.resource.size < 10 * 1024 * 1024  // Max 10MB per file
                   && request.resource.contentType.matches('image/.*');  // Images only
      allow delete: if request.auth != null && request.auth.uid == breederId;
    }

    // Public marketplace photos: readable by anyone authenticated
    match /marketplace/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
