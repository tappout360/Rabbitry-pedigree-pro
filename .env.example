# ============================================
# RabbitryPedigree Pro — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

# MongoDB Atlas Connection String
# Get this from: MongoDB Atlas > Database > Connect > Drivers > Node.js
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=rabbitrypedigree

# JWT Secret for authentication tokens
# Generate a strong random string (32+ characters)
JWT_SECRET=change-this-to-a-very-long-random-secret-string-here

# Stripe (for subscriptions — add when ready)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# STRIPE_SECRET_KEY=sk_test_your_key_here

# App URL (set by Vercel automatically, override for local dev)
# VITE_API_URL=http://localhost:3000
